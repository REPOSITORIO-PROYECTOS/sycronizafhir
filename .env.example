LOCAL_POSTGRES_URL=postgres://postgres:your-local-password@127.0.0.1:5433/mascotas?sslmode=disable
DB_SOURCE_MODE=manual
DB_SOURCE_PRIORITY=docker,local
# Relative paths resolve to %APPDATA%\sycronizafhir\sync_queue.db (stable for Wails/background).
SQLITE_QUEUE_PATH=./sync_queue.db

# OBLIGATORIAS (desde 1.6.27 el binario no trae credenciales ni proyecto por defecto;
# si falta alguna, la app no arranca y lo informa en errores\app.log).
# Base Supabase: SUPABASE_DB_URL completa (tiene prioridad) o HOST/PUERTO/USUARIO/CONTRASENA.
# Pooler: postgres.<ref> como usuario. La app usa protocolo simple, sirve el pooler de transacciones (6543).
SUPABASE_DB_URL=postgresql://postgres.your-project:your-db-password@aws-1-your-region.pooler.supabase.com:6543/postgres?sslmode=require
HOST_SUPABASE=aws-1-your-region.pooler.supabase.com
PUERTO_SUPABASE=6543
USUARIO_SUPABASE=postgres.your-project
CONTRASENA_SUPABASE=your-db-password
SUPABASE_DB_NAME=postgres
SUPABASE_DB_SSLMODE=require

SUPABASE_URL=https://your-project.supabase.co
# Dashboard → Project Settings → API → service_role (secret). NO usar anon key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alias opcional si tu .env legacy usa SUPABASE_SERVICE_ROLE sin _KEY:
# SUPABASE_SERVICE_ROLE=your-service-role-key
SUPABASE_REALTIME_URL=wss://your-project.supabase.co/realtime/v1/websocket?vsn=1.0.0
SUPABASE_REALTIME_CHANNEL=realtime:public:pedidos
SUPABASE_REALTIME_SCHEMA=public
SUPABASE_REALTIME_TABLE=pedidos

OUTBOUND_INTERVAL_SECONDS=60
DEVICE_ID=
DEVICE_PRESENCE_INTERVAL_SECONDS=60
SYNC_SOURCE_SCHEMA=public
SYNC_EXCLUDE_TABLES=sync_buzon_pedidos
BOOTSTRAP_CHUNK_SIZE=500
SYNC_AUDIT_INTERVAL_HOURS=6
IMAGE_SYNC_ENABLED=true
IMAGE_SYNC_INTERVAL_SECONDS=300
# Productos locales procesados por ciclo automático (default 150). Manual «Subir ahora» = sin límite.
IMAGE_SYNC_AUTO_BATCH=150
IMAGE_LOCAL_BASE_PATH=C:\Sys_Image
SUPABASE_STORAGE_BUCKET_PRODUCTOS=productos

# Opcionales: email del dbscan (sin valores por defecto embebidos)
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_EMAIL_FROM=
MAIL_EMAIL_TO=
MAIL_EMAIL_CC=
MAIL_EMAIL_BCC=
MAIL_EMAIL_SUBJECT=
MAIL_EMAIL_BODY=
MAIL_EMAIL_ATTACHMENT=
